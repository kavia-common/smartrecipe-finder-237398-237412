# SnapChef Backend - environment variables

# Required for Postgres connectivity (provided by the "database" container)
POSTGRES_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# Optional app config
# Comma-separated origins for CORS (default: *)
CORS_ALLOW_ORIGINS=*
# Default page size for list endpoints
DEFAULT_PAGE_SIZE=20
# Max page size clamp for list endpoints
MAX_PAGE_SIZE=100

# Demo mode configuration
# If set, API can auto-create a demo user if X-Demo-User header is not provided
DEMO_AUTO_CREATE_USER=true
